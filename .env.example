# Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay Dashboard -> Account & Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_me
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx

# Public base URL, e.g. https://glassstudio.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin API access: set a long random password; use only from server-side admin tooling.
ADMIN_API_SECRET=replace_with_a_random_secret_at_least_32_characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_unique_password